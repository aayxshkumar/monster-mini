# Supabase (auth + user management)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Turso (multi-tenant cafe data)
TURSO_DATABASE_URL=libsql://your-platform-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
TURSO_ORG_NAME=your-turso-org

# Platform admin (super-admin email domain — any user with this email is super-admin)
SUPER_ADMIN_EMAILS=aayush@archivio.app

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
