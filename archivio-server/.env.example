# ARCHIVIO Photo Booth — Pi Server Environment Variables
# Copy to .env and customize as needed

# Printer device path (default: /dev/usb/lp0)
LP_DEVICE=/dev/usb/lp0

# CUPS printer name (leave empty for direct USB printing)
CUPS_PRINTER=

# Print width in pixels (default: 576 for 80mm thermal printer)
WIDTH=576

# Print margin in pixels (default: 0 for full-width)
MARGIN=0

# API key for authenticating dashboard/platform requests (leave empty to disable)
API_KEY=
