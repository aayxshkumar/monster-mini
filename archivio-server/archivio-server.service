# ARCHIVIO Photo Booth — systemd unit
# Install: sudo cp archivio-server.service /etc/systemd/system/
#         sudo systemctl daemon-reload
#         sudo systemctl enable archivio-server
#         sudo systemctl start archivio-server
# Logs:   journalctl -u archivio-server -f

[Unit]
Description=ARCHIVIO Photo Booth API Server
After=network.target

[Service]
Type=simple
User=monster-pi
Group=monster-pi
WorkingDirectory=/home/monster-pi/archivio-server
Environment=PORT=5000
ExecStart=/home/monster-pi/.local/bin/gunicorn --bind 0.0.0.0:5000 --workers 2 --threads 4 --timeout 300 server:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
