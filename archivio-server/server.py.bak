    print("=" * 50)
    print("  ARCHIVIO Photo Booth Server v2.1")
    print(f"  Uploads:  {UPLOAD_DIR}")
    print(f"  Stickers: {STICKER_DIR}")
    print(f"  Printer:  {LP_DEVICE} ({'found' if os.path.exists(LP_DEVICE) else 'NOT FOUND'})")
    print(f"  Camera:   {'detected' if check_camera() else 'not detected'}")
    print("  Print queue: background worker started")
    print("  Features: grid photos, stickers, rounded corners")
    print("=" * 50)
    app.run(host="0.0.0.0", port=5000, debug=False)
